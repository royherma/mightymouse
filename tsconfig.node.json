{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/vite-env.d.ts"
  ],
  "exclude": ["src/**/__tests__/**", "src/**/*.test.ts", "src/main/phone-remote/react/**"],
  "compilerOptions": {
    "composite": true,
    "noImplicitAny": true,
    "types": ["electron-vite/node"]
  }
}
