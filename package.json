{
  "name": "mightymouse",
  "version": "0.55.0",
  "description": "MightyMouse floating rewrite and ask AI utility",
  "main": "./out/main/index.js",
  "author": "Roy Hermann",
  "homepage": "https://github.com/royherma/mightymouse",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:login": "MM_FORCE_LOGIN=1 electron-vite dev",
    "dev:console": "node scripts/dev-console.mjs",
    "build": "npm run build:typecheck-maybe && npm run build:phone-remote:release && electron-vite build",
    "build:typecheck-maybe": "node -e \"process.exit(process.env.MM_SKIP_TYPECHECK==='1'?0:1)\" || npm run typecheck",
    "build:phone-remote": "vite build --config src/main/phone-remote/react/vite.config.ts",
    "build:phone-remote:release": "cross-env MM_MIRROR_STATS=0 npm run build:phone-remote",
    "check": "npm run typecheck && npm run lint && npm run test",
    "check:providers": "node scripts/check-providers.mjs",
    "gen:ios-theme": "node scripts/gen-ios-theme.mjs",
    "check:ios-theme": "node scripts/gen-ios-theme.mjs --check",
    "prepare": "echo skip",
    "postinstall": "node scripts/sync-vad-assets.mjs && electron-builder install-app-deps && node scripts/build-passkeys-addon.mjs || true",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "build:helpers": "bash native/build-all.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coordination": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run --config vitest.coordination.config.mts",
    "test:coverage": "vitest run --coverage",
    "build:mac": "npm run build && electron-builder --mac --publish never -c.mac.identity=null"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@ricky0123/vad-web": "^0.0.30",
    "@supabase/supabase-js": "^2.106.2",
    "better-sqlite3": "^13.0.3",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.3",
    "koffi": "^3.3.3",
    "lucide-react": "^1.17.0",
    "qrcode": "^1.5.4",
    "react-markdown": "^9.1.0",
    "recharts": "^3.9.2",
    "remark-gfm": "^4.0.1",
    "selfsigned": "^2.4.1",
    "three": "^0.185.1",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "node-mac-permissions": "^2.5.0"
  },
  "overrides": {
    "onnxruntime-web": "1.27.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.7",
    "acorn": "^8.19.0",
    "autoprefixer": "^10.5.0",
    "cross-env": "10.1.0",
    "electron": "^43.7.9",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "happy-dom": "^15.11.7",
    "node-addon-api": "^8.9.2",
    "postcss": "^8.5.15",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.7"
  }
}
