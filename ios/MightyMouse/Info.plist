<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>$(MM_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>MightyMouse</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.10</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mightymouse</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>22</string>
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Mighty Mouse</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>my tee mouse</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Mighty</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>my tee</string>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MMStagingTestPassword</key>
	<string>$(MM_STAGING_TEST_PASSWORD)</string>
	<key>MMSupabaseAnonKey</key>
	<string>$(MM_SUPABASE_ANON_KEY)</string>
	<key>MMSupabaseRef</key>
	<string>$(MM_SUPABASE_REF)</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_https._tcp.</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>MightyMouse uses the camera to scan the pairing QR code on your Mac, and for an optional picture-in-picture view.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>MightyMouse looks for your Mac on this Wi-Fi network so this phone can control it.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>MightyMouse uses the microphone for dictation and voice commands.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>MightyMouse lets an agent on your Mac find a photo you ask for, like a screenshot you just took. It only ever sees the photos you allow.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>MightyMouse writes out what you said on this phone, so you can see it even when your Mac isn't reachable. Your voice stays on the device.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSUserActivityTypes</key>
	<array>
		<string>INSendMessageIntent</string>
	</array>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
